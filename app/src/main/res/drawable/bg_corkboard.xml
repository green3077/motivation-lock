<?xml version="1.0" encoding="utf-8"?>
<!-- 실제 코르크 텍스처 이미지 없이, 나무 액자 느낌의 진한 갈색 테두리 + 코르크색 안쪽 배경으로
     "게시판" 느낌을 낸다. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#6B4226" />
        </shape>
    </item>
    <item
        android:top="16dp"
        android:bottom="16dp"
        android:left="16dp"
        android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#D8B589" />
        </shape>
    </item>
</layer-list>
