# 이 파일을 복사해 keystore.properties로 저장한 뒤 실제 값을 채우세요.
# keystore.properties는 .gitignore에 들어 있어 git에 커밋되지 않습니다.
#
# release keystore가 아직 없다면 먼저 만드세요(한 번만):
#   keytool -genkeypair -v -keystore <keystore 저장 경로> -alias motivationlock ^
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile은 이 저장소 밖의 안전한 위치를 절대경로로 지정하는 걸 권장합니다.
# 이 키를 잃어버리면 기존에 설치된 앱을 같은 서명으로 다시는 업데이트할 수 없으니 반드시 백업하세요.

storeFile=C:/Users/hkjin/keys/motivation-lock-release.jks
storePassword=CHANGE_ME
keyAlias=motivationlock
keyPassword=CHANGE_ME
